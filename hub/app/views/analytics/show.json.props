json.pageTitle t("analytics.heading")
json.signOutLabel t("authenticated.sign_out")
json.accountMenuLabel t("authenticated.account_menu", login: Current.user.login)
json.partial! partial: "shared/hub_administration_navigation"
json.collapseNavigationLabel t("repository_workspace.collapse_navigation")
json.expandNavigationLabel t("repository_workspace.expand_navigation")
json.systemThemeLabel t("repository_workspace.theme_system")
json.lightThemeLabel t("repository_workspace.theme_light")
json.darkThemeLabel t("repository_workspace.theme_dark")
json.signOutPath session_path
json.authenticityToken form_authenticity_token

json.currentUser do
  json.login Current.user.login
  json.name Current.user.name
  json.avatarUrl Current.user.avatar_url
end

json.repositorySelectorLabel t("repository_workspace.repository_selector", repository: @repository.name_with_owner)
json.repositoryMenuLabel t("repository_workspace.repositories")
json.navigationLabel t("repository_workspace.navigation")
json.newPrototypeLabel t("repository_workspace.new_prototype")
json.newPrototypePath repository_new_prototype_path(@repository.route_id)
json.prototypesLabel t("repository_workspace.prototypes")
json.prototypesPath repository_path(@repository.route_id)
json.partial! partial: "shared/analytics_navigation"
json.selectedSection "analytics"
json.selectedRepositoryId @repository.route_id.to_s

json.repositories do
  json.array! @repositories do |repository|
    json.id repository.route_id.to_s
    json.nameWithOwner repository.name_with_owner
    json.path repository_path(repository.route_id)
  end
end

json.alert flash[:alert]
json.notice flash[:notice]
json.createPath repository_analytics_destinations_path(@repository.route_id)

json.copy do
  json.heading t("analytics.page.heading")
  json.description t("analytics.page.description")
  json.privacy t("analytics.page.privacy")
  json.destinations t("analytics.page.destinations")
  json.empty t("analytics.page.empty")
  json.add t("analytics.page.add")
  json.cancel t("analytics.page.cancel")
  json.provider t("analytics.page.provider")
  json.segment t("analytics.page.segment")
  json.mixpanel t("analytics.page.mixpanel")
  json.custom t("analytics.page.custom")
  json.region t("analytics.page.region")
  json.us t("analytics.page.us")
  json.eu t("analytics.page.eu")
  json.in t("analytics.page.in")
  json.writeKey t("analytics.page.write_key")
  json.serviceAccountUsername t("analytics.page.service_account_username")
  json.serviceAccountSecret t("analytics.page.service_account_secret")
  json.projectId t("analytics.page.project_id")
  json.mixpanelHelp t("analytics.page.mixpanel_help")
  json.rotation t("analytics.page.rotation")
  json.eventTypes t("analytics.page.event_types")
  json.history t("analytics.page.history")
  json.newEvents t("analytics.page.new_events")
  json.retainedEvents t("analytics.page.retained_events")
  json.historyWarning t("analytics.page.history_warning")
  json.save t("analytics.page.save")
  json.configured t("analytics.page.configured")
  json.paused t("analytics.page.paused")
  json.failed t("analytics.page.failed")
  json.pause t("analytics.page.pause")
  json.resume t("analytics.page.resume")
  json.disconnect t("analytics.page.disconnect")
  json.failureHelp t("analytics.page.failure_help")
  json.customName t("analytics.page.custom_name")
  json.customEndpoint t("analytics.page.custom_endpoint")
  json.customEndpointHelp t("analytics.page.custom_endpoint_help")
  json.customHeaders t("analytics.page.custom_headers")
  json.customHeaderRetention t("analytics.page.custom_header_retention")
  json.customTemplate t("analytics.page.custom_template")
  json.customSecrets t("analytics.page.custom_secrets")
  json.customSecretName t("analytics.page.custom_secret_name")
  json.customSecretValue t("analytics.page.custom_secret_value")
  json.customAddSecret t("analytics.page.custom_add_secret")
  json.customSuccessPointer t("analytics.page.custom_success_pointer")
  json.customSuccessValue t("analytics.page.custom_success_value")
  json.customPreview t("analytics.page.custom_preview")
  json.customPreviewHelp t("analytics.page.custom_preview_help")
  json.customPreviewInvalid t("analytics.page.custom_preview_invalid")
  json.customKeepPending t("analytics.page.custom_keep_pending")
  json.customBacklogWarning t("analytics.page.custom_backlog_warning")
  json.customRetryWarning t("analytics.page.custom_retry_warning")
  json.customEndpointExample t("analytics.page.custom_endpoint_example")
  json.customTemplateExample t("analytics.page.custom_template_example")
  json.customHeadersExample t("analytics.page.custom_headers_example")
end

json.eventTypes do
  json.array! Analytics::Event::TYPES do |name|
    json.value name
    json.label t("analytics.events.#{name}")
  end
end

json.authenticationHeaders Analytics::CustomConfiguration::AUTHENTICATION_HEADERS

json.destinations do
  json.array! @destinations do |destination|
    json.id destination.id.to_s
    json.provider destination.provider
    json.region destination.region
    json.enabled destination.enabled
    json.eventTypes destination.event_types
    json.deliveryFailed @failure_codes.key?(destination.id)
    json.path repository_analytics_destination_path(@repository.route_id, destination)
    if destination.provider == "custom"
      json.name destination.name
      json.customConfig destination.public_custom_config
      if (code = @failure_codes[destination.id])
        json.failureDetail(
          if code.match?(/\Ahttp_[1-5]\d\d\z/)
            t("analytics.failures.http_status", status: code.delete_prefix("http_"))
          else
            t("analytics.failures.#{code}", default: t("analytics.failures.unknown"))
          end
        )
      end
    end
  end
end
