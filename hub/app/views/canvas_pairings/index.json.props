json.kind "connections"
json.pageTitle t("canvas_pairings.index.page_title")
json.productName t("application.name")
json.heading t("canvas_pairings.index.heading")
json.description t("canvas_pairings.index.description")
json.emptyLabel t("canvas_pairings.index.empty")
json.backLabel t("canvas_pairings.index.back")
json.backPath repositories_path
json.revokeLabel t("canvas_pairings.index.revoke")
json.notice flash[:notice]
json.authenticityToken form_authenticity_token

json.grants do
  json.array! @grants do |grant|
    json.id grant.id
    json.repository grant.repository.name_with_owner
    json.expiresLabel t \
      "canvas_pairings.index.expires",
      date: (grant.inactive_at || grant.expires_at).utc.strftime("%B %-d, %Y at %H:%M UTC")
    json.revokePath canvas_connection_path(grant)
  end
end
