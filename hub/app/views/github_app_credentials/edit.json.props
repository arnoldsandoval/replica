json.partial! partial: "github_apps/configuration"
json.pageTitle t("github_app.credentials.heading")
json.heading t("github_app.credentials.heading")
json.description t("github_app.credentials.description")
json.paragraphs []
json.links []
json.form do
  json.action github_app_credentials_path
  json.set! :method, "patch"
  json.submitLabel t("github_app.credentials.submit")
  json.confirmLabel t("github_app.credentials.confirm")
  json.disabled !!(
    @configuration.webhook_request_expires_at && @configuration.webhook_request_expires_at > Time.current
  )
  json.credentials do
    json.secretLabel t("github_app.credentials.secret")
    json.keyLabel t("github_app.credentials.key")
    json.limits t("github_app.credentials.limits")
  end
end
