json.partial! partial: "github_apps/configuration"
state = @configuration.webhook_rotation_state
operation = { "idle" => "start", "pending" => "retry", "confirmed" => "finish" }.fetch(state)
json.pageTitle t("github_app.webhook.heading")
json.heading t("github_app.webhook.heading")
json.description t("github_app.webhook.description")
json.paragraphs [ t("github_app.webhook.#{state}") ]
json.links []
json.form do
  json.action github_app_webhook_rotation_path
  json.set! :method, state == "confirmed" ? "delete" : "post"
  json.operation operation if operation != "finish"
  json.submitLabel t("github_app.webhook.#{operation}")
  json.confirmLabel t("github_app.webhook.confirm_#{operation}")
  json.disabled !!(
    @configuration.webhook_request_expires_at && @configuration.webhook_request_expires_at > Time.current
  )
end
