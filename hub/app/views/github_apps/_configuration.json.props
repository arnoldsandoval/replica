json.partial! partial: "hub_admins/navigation"
json.hubAdminsLabel t("github_app.admins")
json.hubAdminsPath hub_admins_path
json.verification t("github_app.verification")
json.configurationId @configuration&.id
json.version @configuration&.lock_version
identity = if @configuration
  t \
    "github_app.identity", app_id: @configuration.github_app_id,
    owner: @configuration.owner_login, owner_type: @configuration.owner_type,
    owner_id: @configuration.owner_github_id
end
installation = if @configuration
  t \
    "github_app.installation", installation_id: @configuration.installation_id || "-",
    state: @configuration.installation_state
end
json.identity identity
json.installation installation
busy = @configuration&.webhook_request_expires_at && @configuration.webhook_request_expires_at > Time.current
json.busyLabel(busy ? t("github_app.busy") : nil)
