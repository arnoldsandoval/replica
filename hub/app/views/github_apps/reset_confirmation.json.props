json.partial! partial: "github_apps/configuration"
json.pageTitle t("github_app.reset.heading")
json.heading t("github_app.reset.heading")
json.description t("github_app.reset.description")
json.paragraphs [ t("github_app.reset.consequences"), t("github_app.reset.shares") ]
json.links []
json.form do
  json.action github_app_path
  json.set! :method, "delete"
  json.submitLabel t("github_app.reset.submit")
  json.confirmLabel t("github_app.reset.confirm")
  json.disabled !!(!@bootstrap_ready || (
    @configuration.webhook_request_expires_at && @configuration.webhook_request_expires_at > Time.current
  ))
  json.blockedLabel(@bootstrap_ready ? nil : t("github_app.errors.bootstrap_missing"))
  json.confirmationPhraseLabel t("github_app.reset.phrase")
end
