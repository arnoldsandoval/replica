local_mode = LocalDevelopment.enabled?

json.pageTitle t("application.name")
json.localMode local_mode
json.badge t(local_mode ? "home.index.local_badge" : "home.index.badge")
json.badgeAlternate t(local_mode ? "home.index.local_badge_alternate" : "home.index.badge_alternate")
json.heading t(local_mode ? "home.index.local_heading" : "home.index.heading")
json.description t(local_mode ? "home.index.local_description" : "home.index.description")
json.footerNote t("home.index.footer_note", year: Date.current.year)
json.alert flash[:alert]
json.notice flash[:notice]
json.signInLabel t(local_mode ? "home.index.local_sign_in" : "home.index.sign_in")
json.pauseAnimationLabel t("home.index.pause_animation")
json.resumeAnimationLabel t("home.index.resume_animation")
json.signInPath(local_mode ? local_authentication_path : github_authentication_path)
json.authenticityToken form_authenticity_token
