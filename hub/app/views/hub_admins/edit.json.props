json.partial! partial: "hub_admins/navigation"
json.pageTitle t("hub_admins.confirmation.#{@operation}.heading")
json.heading t("hub_admins.confirmation.#{@operation}.heading")
json.description t("hub_admins.confirmation.#{@operation}.description")
json.target do
  json.login @target.login
  json.name @target.name
  json.identity t("hub_admins.identity", github_id: @target.github_id, id: @target.id)
end
json.operation @operation
json.submitPath hub_admin_path(@target)
json.submitLabel t("hub_admins.#{@operation}")
json.confirmLabel t("hub_admins.confirm")
json.cancelLabel t("hub_admins.cancel")
json.cancelPath hub_admins_path
json.verification t("hub_admins.verification")
json.blockedLabel(@last_admin ? t("hub_admins.errors.last_admin") : nil)
