json.partial! partial: "hub_admins/navigation"
json.pageTitle t("hub_admins.heading")
json.heading t("hub_admins.heading")
json.description t("hub_admins.description")
json.emptyLabel t(@access_denied ? "hub_admins.no_admin_access" : "hub_admins.empty")
json.nextLabel t("hub_admins.next")
json.nextPath @next_path
json.addLabel t("hub_admins.add")
json.administratorsLabel @access_denied ? nil : t("hub_admins.count", count: @administrator_count)
if @access_denied
  json.addAdministrator nil
else
  json.addAdministrator do
    json.submitPath hub_admins_path
    json.searchPath candidates_hub_admins_path
    json.heading t("hub_admins.add_dialog.heading")
    json.description t("hub_admins.add_dialog.description")
    json.searchLabel t("hub_admins.add_dialog.search")
    json.searchPlaceholder t("hub_admins.add_dialog.search_placeholder")
    json.loadingLabel t("hub_admins.add_dialog.loading")
    json.emptyLabel t("hub_admins.add_dialog.empty")
    json.moreLabel t("hub_admins.add_dialog.more")
    json.selectedLabel t("hub_admins.add_dialog.selected")
    json.confirmLabel t("hub_admins.add_dialog.confirm")
    json.submitLabel t("hub_admins.add_dialog.submit")
    json.searchFailedLabel t("hub_admins.add_dialog.search_failed")
    json.retryLabel t("hub_admins.add_dialog.retry")
    json.cancelLabel t("hub_admins.cancel")
  end
end
json.users do
  json.array! @users do |user|
    json.id user.id
    json.login user.login
    json.name user.name
    json.identity t("hub_admins.identity", github_id: user.github_id, id: user.id)
    json.role t("hub_admins.admin")
    json.actionLabel t("hub_admins.revoke")
    json.confirmationPath edit_hub_admin_path(user)
  end
end
