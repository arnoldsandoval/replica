path = request.format.json? ? param_to_dig_path(params[:props_at]) : nil

json.data(dig: path) { yield json }
json.componentIdentifier active_template_virtual_path
json.defers json.deferred!
json.fragments json.fragments!
json.assets [vite_asset_path("application.tsx")]
json.csrfToken form_authenticity_token if protect_against_forgery?

if path
  json.action "graft"
  json.path params[:props_at]
end

json.restoreStrategy authenticated? ? "revisitOnly" : "fromCacheAndRevisitInBackground"
json.renderedAt Time.current.to_i
json.slices { json.flash flash.to_h }
