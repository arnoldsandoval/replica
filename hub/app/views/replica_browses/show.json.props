json.pageTitle @template.fetch("name")
json.templateId @template.fetch("id")
json.signOutLabel t("authenticated.sign_out")
json.accountMenuLabel t("authenticated.account_menu", login: Current.user.login)
json.partial! partial: "shared/hub_administration_navigation"
json.collapseNavigationLabel t("repository_workspace.collapse_navigation")
json.expandNavigationLabel t("repository_workspace.expand_navigation")
json.systemThemeLabel t("repository_workspace.theme_system")
json.lightThemeLabel t("repository_workspace.theme_light")
json.darkThemeLabel t("repository_workspace.theme_dark")
json.signOutPath session_path
json.authenticityToken form_authenticity_token

json.currentUser do
  json.login Current.user.login
  json.name Current.user.name
  json.avatarUrl Current.user.avatar_url
end

json.repositorySelectorLabel t \
  "repository_workspace.repository_selector",
  repository: @repository.name_with_owner
json.repositoryMenuLabel t("repository_workspace.repositories")
json.navigationLabel t("repository_workspace.navigation")
json.newPrototypeLabel t("repository_workspace.new_prototype")
json.newPrototypePath repository_new_prototype_path(@repository.route_id)
json.prototypesLabel t("repository_workspace.prototypes")
json.prototypesPath repository_path(@repository.route_id)
json.partial! partial: "shared/analytics_navigation"
json.selectedSection "new"
json.selectedRepositoryId @repository.route_id.to_s

json.repositories do
  json.array! @repositories do |repository|
    json.id repository.route_id.to_s
    json.nameWithOwner repository.name_with_owner
    json.path repository_path(repository.route_id)
  end
end

json.browseReplica true
json.repositoryName @repository.name_with_owner
json.repositoryPath repository_path(@repository.route_id)
json.branchName @repository.default_branch
json.branchPath repository_template_path(@repository.route_id, @template.fetch("id"))
json.prototypeName @template.fetch("name")
json.closePath repository_new_prototype_path(@repository.route_id)
json.closeLabel t("prototypes.show.close")
json.useDarkThemeLabel t("prototypes.show.use_dark_theme")
json.useLightThemeLabel t("prototypes.show.use_light_theme")
json.minimizeHubLabel t("prototypes.show.minimize_hub")
json.maximizeHubLabel t("prototypes.show.maximize_hub")
json.dragControlsLabel t("prototypes.show.drag_controls")
json.minimizedPreview params[:view] == "minimized"
json.previewUrlLabel t("prototypes.show.prototype_link")
json.copyPreviewUrlLabel t("prototypes.show.copy_prototype_link")
json.copiedPreviewUrlLabel t("prototypes.show.copied_prototype_link")
json.copyPreviewUrlErrorLabel t("prototypes.show.copy_prototype_link_error")
json.forkLabel t("prototypes.show.fork")
json.branchFromLabel t("replica_browses.show.branch_from", branch: @repository.default_branch)
json.branchPlaceholder t("prototypes.show.branch_placeholder")
json.branchSubmitLabel t \
  @repository.local? ? "new_prototypes.show.copy_prompt_label" : "new_prototypes.show.submit_label"
json.branchSubmissionMode(@repository.local? ? "copy" : "copilot")
json.branchInstructions t("replica_browses.show.branch_instructions")
json.branchPageInstructions t("prototype_prompts.viewed_page", route: "%{route}")
if @template.fetch("id") != "default"
  json.templateLandingPageInstructions t("templates.detail.landing_page_instructions", route: "%{route}")
end

json.branchContinuation do
  json.continuationHeading t("new_prototypes.show.continuation_heading")
  json.continueMessage t("new_prototypes.show.continue_message")
  json.installMessage t("new_prototypes.show.install_message")
  json.downloadLabel t("new_prototypes.show.download_label")
  json.downloadUrl t("new_prototypes.show.download_url")
  json.openAppLabel t("new_prototypes.show.open_app_label")
  json.closeLabel t("new_prototypes.show.close_label")
  json.copyPromptLabel t("new_prototypes.show.copy_prompt_label")
  json.copiedLabel t("new_prototypes.show.copied_label")
  json.copyErrorLabel t("new_prototypes.show.copy_error_label")
end

json.emptyHeading t("replica_browses.show.empty_heading")
json.emptyLabel t \
  "replica_browses.show.states.#{@latest_build&.state || 'unavailable'}",
  branch: @repository.default_branch

if @latest_build
  json.latestBuild do
    json.number @latest_build.number
    json.state @latest_build.state
    json.stateLabel t("build_states.#{@latest_build.state}")
  end
end

if @selected_build
  json.controlsIdentity preview_controls_identity \
    @selected_build.prototype,
    context: [ "authenticated", Current.user.id, "template", @template.fetch("id") ]

  json.selectedBuild do
    json.number @selected_build.number
    json.previewUrl "#{PreviewOrigin.current.url(@selected_build.id)}#{@preview_path.delete_prefix('/')}"
    json.frameTitle t \
      "prototypes.show.frame_title",
      branch: @repository.default_branch,
      number: @selected_build.number
  end
end
