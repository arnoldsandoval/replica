json.pageTitle t(@ended ? "session_revocation.succeeded" : "session_revocation.heading")
json.heading t(@ended ? "session_revocation.succeeded" : "session_revocation.heading")
json.description t(@ended ? "session_revocation.result" : "session_revocation.description")
json.auditLabel t("hub_admins.audit")
json.auditPath(@ended || @access_denied ? nil : security_audit_path)
json.hubAdminsLabel t("hub_admins.heading")
json.hubAdminsPath(@ended || @access_denied ? nil : hub_admins_path)
json.sharingSettingsLabel t("sharing_settings.heading")
json.sharingSettingsPath(@ended || @access_denied ? nil : sharing_settings_path)
json.repositoriesLabel t("hub_admins.repositories")
json.repositoriesPath repositories_path
json.signOutLabel t("authenticated.sign_out")
json.signOutPath session_path
json.authenticityToken form_authenticity_token
json.notice flash[:notice]
json.alert(@disconnect_failed ? t("session_revocation.disconnect_failed") : flash[:alert])
json.signedOut !!@ended
json.canRevoke !@ended && !@access_denied
json.scope t(@ended ? "session_revocation.result_scope" : "session_revocation.scope")
json.ownSession(Current.user ? t("session_revocation.own_session", login: Current.user.login) : nil)
json.verification t("session_revocation.verification")
json.counts(@browser_count ? t(
  "session_revocation.counts", browsers: @browser_count, canvases: @canvas_count, pairings: @pairing_count
) : nil)
json.emptyLabel(@browser_count == 1 && @canvas_count == 0 && @pairing_count == 0 ? t("session_revocation.empty") : nil)
json.confirmLabel t("session_revocation.confirm")
json.submitLabel t("session_revocation.submit")
json.cancelLabel t("session_revocation.cancel")
json.submitPath session_revocation_path
json.signInLabel t("session_revocation.sign_in")
json.signInPath root_path
json.partial! partial: "shared/hub_administration_workspace", locals: { selected_section: "sessions" }
