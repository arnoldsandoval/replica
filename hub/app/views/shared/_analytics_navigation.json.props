json.analyticsLabel t("analytics.heading")
json.analyticsPath \
  (@repository.authorization.sufficient?(@repository_permission, minimum: :admin) ?
    repository_analytics_path(@repository.route_id) : nil)
json.partial! partial: "shared/notification_navigation"
json.learningsLabel t("learnings.heading")
json.learningsPath \
  (@repository.authorization.sufficient?(@repository_permission, minimum: :admin) &&
    Learning.available_for?(@repository) ? repository_learnings_path(@repository.route_id) : nil)
json.securityAuditLabel t("security_audit.heading")
if @repository.authorization.sufficient?(@repository_permission, minimum: :admin)
  json.securityAuditPath repository_security_audit_path(@repository.route_id)
else
  hub_admin = User.where(id: Current.user.id, hub_admin: true).where.not(github_id: nil).exists?
  json.securityAuditPath(hub_admin ? security_audit_path : nil)
end
