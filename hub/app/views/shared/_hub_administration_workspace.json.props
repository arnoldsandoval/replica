# The saved role gates the admin section, not the ordinary signed-in shell.
hub_admin = Current.user &&
  User.where(id: Current.user.id, hub_admin: true).where.not(github_id: nil).exists?
if hub_admin && !@access_denied && !@ended
  json.administrationWorkspace do
    json.partial! \
      partial: "shared/hub_workspace",
      locals: { navigation_label: t("repository_workspace.navigation"), selected_section: }
    json.selectedSection selected_section
  end
  json.authenticatedWorkspace nil
else
  json.administrationWorkspace nil
  if Current.user && !@ended && User.exists?(Current.user.id)
    json.authenticatedWorkspace do
      json.partial! \
        partial: "shared/hub_workspace",
        locals: { navigation_label: t("hub_administration_workspace.hub_navigation") }
      json.selectedSection selected_section
    end
  else
    json.authenticatedWorkspace nil
  end
end
