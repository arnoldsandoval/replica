json.productName t("application.name")
json.navigationLabel navigation_label
json.collapseNavigationLabel t("repository_workspace.collapse_navigation")
json.expandNavigationLabel t("repository_workspace.expand_navigation")
json.accountMenuLabel t("authenticated.account_menu", login: Current.user.login)
json.authenticityToken form_authenticity_token
json.systemThemeLabel t("repository_workspace.theme_system")
json.lightThemeLabel t("repository_workspace.theme_light")
json.darkThemeLabel t("repository_workspace.theme_dark")
json.signOutLabel t("authenticated.sign_out")
json.signOutPath session_path
json.currentUser do
  json.login Current.user.login
  json.name Current.user.name
  json.avatarUrl Current.user.avatar_url
end
json.repositoriesLabel t("hub_admins.repositories")
json.repositoriesPath repositories_path
workspace = hub_repository_workspace
repository = workspace.fetch(:repository)
json.partial! \
  partial: "shared/notification_navigation",
  locals: { context_repository: repository }
json.repositoryUnavailableMessage workspace.fetch(:error)
if repository
  json.repository do
    json.partial! \
      partial: "shared/repository_navigation_context",
      locals: { repository:, repositories: workspace.fetch(:repositories), permission: workspace.fetch(:permission) }
  end
else
  json.repository nil
end
json.partial! \
  partial: "shared/hub_administration_navigation",
  locals: { administration_allowed: !@access_denied, context_repository: repository }
json.securityAuditLabel t("security_audit.heading")
hub_admin = !@access_denied &&
  User.where(id: Current.user.id, hub_admin: true).where.not(github_id: nil).exists?
if hub_admin && local_assigns[:selected_section] == "audit"
  json.securityAuditPath security_audit_path
elsif repository&.authorization&.sufficient?(workspace.fetch(:permission), minimum: :admin)
  json.securityAuditPath repository_security_audit_path(repository.route_id)
else
  json.securityAuditPath(hub_admin ? security_audit_path : nil)
end
