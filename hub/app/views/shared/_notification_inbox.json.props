json.path inbox_notifications_path
json.copy do
  json.heading t("notifications.heading")
  json.all t("notifications.all")
  json.unread t("notifications.unread")
  json.unreadCount t("notifications.unread_count", count: "%{count}")
  json.empty t("notifications.empty")
  json.emptyDescription t("notifications.empty_description")
  json.emptyUnread t("notifications.empty_unread")
  json.emptyUnreadDescription t("notifications.empty_unread_description")
  json.viewAll t("notifications.view_all")
  json.markRead t("notifications.mark_read")
  json.markUnread t("notifications.mark_unread")
  json.error t("notifications.error")
  json.loading t("notifications.loading")
  json.loadMore t("notifications.load_more")
  json.retry t("notifications.retry")
  json.actions do
    json.comment t("notifications.actions.comment")
    json.mention t("notifications.actions.mention")
    json.reply t("notifications.actions.reply")
    json.reaction t("notifications.actions.reaction")
    json.resolved t("notifications.actions.resolved")
    json.reopened t("notifications.actions.reopened")
  end
end
