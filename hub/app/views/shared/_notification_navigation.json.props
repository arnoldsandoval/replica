context_repository = local_assigns.fetch(:context_repository, @repository)
json.notificationsPath notifications_path(repository_github_id: context_repository&.route_id)
json.partial! \
  partial: "shared/welcome_navigation",
  locals: { context_repository: }
json.notificationsLabel t("notifications.heading")
json.notificationsUnread notifications_unread?
json.notificationsUnreadCount notifications_unread_count
json.notificationsUnreadLabel t("notifications.unread_count_heading", count: notifications_unread_count)
json.notificationInbox do
  json.partial! partial: "shared/notification_inbox"
end
