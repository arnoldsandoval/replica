json.repositorySelectorLabel t("repository_workspace.repository_selector", repository: repository.name_with_owner)
json.repositoryMenuLabel t("repository_workspace.repositories")
json.selectedRepositoryId repository.route_id.to_s
json.newPrototypeLabel t("repository_workspace.new_prototype")
json.newPrototypePath repository_new_prototype_path(repository.route_id)
json.prototypesLabel t("repository_workspace.prototypes")
json.prototypesPath repository_path(repository.route_id)
json.analyticsLabel t("analytics.heading")
json.analyticsPath \
  (repository.authorization.sufficient?(permission, minimum: :admin) ?
    repository_analytics_path(repository.route_id) : nil)
json.learningsLabel t("learnings.heading")
json.learningsPath \
  (repository.authorization.sufficient?(permission, minimum: :admin) && Learning.available_for?(repository) ?
    repository_learnings_path(repository.route_id) : nil)
json.repositories do
  json.array! repositories do |available_repository|
    json.id available_repository.route_id.to_s
    json.nameWithOwner available_repository.name_with_owner
    json.path repository_path(available_repository.route_id)
  end
end
