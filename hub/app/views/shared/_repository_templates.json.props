default_template = {
  "id" => "default",
  "name" => t("templates.default.name"),
  "category" => t("templates.default.category"),
  "description" => t("templates.default.description"),
  "path" => "/"
}
json.templates do
  json.array! [ default_template, *@templates ] do |template|
    json.id template.fetch("id")
    json.name template.fetch("name")
    json.category template.fetch("category")
    json.description template.fetch("description")
    json.route template.fetch("path")
    json.path repository_template_path(@repository.route_id, template.fetch("id"))
    if @selected_build
      json.screenshotSrc repository_template_screenshot_path \
        @repository.route_id,
        template.fetch("id"),
        @selected_build.id,
        "desktop"
      json.darkScreenshotSrc repository_template_screenshot_path \
        @repository.route_id,
        template.fetch("id"),
        @selected_build.id,
        "desktop",
        theme: "dark"
      json.screenshotAlt t("templates.index.screenshot_alt", name: template.fetch("name"))
    end
  end
end
