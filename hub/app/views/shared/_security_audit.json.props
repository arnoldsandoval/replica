json.pageTitle t("security_audit.heading")
json.heading t("security_audit.heading")
json.description t(
  @repository ? "security_audit.repository_description" : "security_audit.global_description",
  repository: @repository&.name_with_owner
)
json.notice flash[:notice]
json.scopeLabel t("security_audit.scope")
json.selectedScopeId(@repository ? @repository.route_id.to_s : "hub")
json.scopes @audit_scopes
json.scopesUnavailableMessage(@audit_scopes_unavailable ? t("security_audit.scopes_unavailable") : nil)
if @repository.nil?
  json.partial! partial: "shared/hub_administration_workspace", locals: { selected_section: "audit" }
end
json.retention t("security_audit.retention")
json.emptyLabel t("security_audit.empty")
json.nextLabel t("security_audit.next")
json.nextPath @next_path
json.repositoriesLabel t("security_audit.repositories")
json.repositoriesPath repositories_path
json.hubAdminsLabel t("hub_admins.heading")
json.hubAdminsPath(@repository.nil? ? hub_admins_path : nil)
json.sharingSettingsLabel t("sharing_settings.heading")
json.sharingSettingsPath(@repository.nil? ? sharing_settings_path : nil)
json.sessionRevocationLabel t("session_revocation.heading")
json.sessionRevocationPath(@repository.nil? ? session_revocation_path : nil)
json.githubAppLabel t("github_app.heading")
json.githubAppPath(@repository.nil? ? github_app_path : nil)
json.copilotConnectionLabel t("copilot_connection.heading")
json.copilotConnectionPath(@repository.nil? ? copilot_connection_path : nil)
json.signOutLabel t("authenticated.sign_out")
json.signOutPath session_path
json.authenticityToken form_authenticity_token
json.columns do
  %w[time action actor ip context outcome].each do |column|
    json.set! column, t("security_audit.columns.#{column}")
  end
end
json.events do
  json.array! @events do |event|
    json.id event.id
    json.time event.occurred_at.utc.iso8601
    json.action event.action
    json.actor(event.user_id ? t("security_audit.actor", id: event.user_id) : t("security_audit.anonymous"))
    json.ip event.ip_address || t("security_audit.unknown_ip")
    json.context event.context.to_json
    json.outcome t("security_audit.outcomes.#{event.outcome}")
  end
end
