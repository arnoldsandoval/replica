json.partial! partial: "hub_admins/navigation"
json.pageTitle t("sharing_settings.heading")
json.heading t("sharing_settings.heading")
json.description t("sharing_settings.description")
json.accessDenied !!@access_denied
json.emptyLabel t(@access_denied ? "sharing_settings.no_access" : "sharing_settings.empty")
if !@access_denied
  json.statusLabel t(@enabled ? "sharing_settings.enabled" : "sharing_settings.disabled")
  json.operation(@enabled ? "disable" : "enable")
  json.submitPath sharing_settings_path
  json.submitLabel t("sharing_settings.#{@enabled ? 'disable' : 'enable'}.label")
  json.consequence t("sharing_settings.#{@enabled ? 'disable' : 'enable'}.consequence")
  json.confirmLabel t("sharing_settings.confirm")
  json.verification t("sharing_settings.verification")
end
