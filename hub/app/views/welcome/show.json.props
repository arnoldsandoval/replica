json.pageTitle t("welcome.heading")
json.heading t("welcome.heading")
json.description t("welcome.description")
json.videoUrl WelcomeVideo.url
json.videoEmbedUrl WelcomeVideo.embed_url
json.videoPosterUrl WelcomeVideo.poster_url
json.videoLabel t("welcome.video_label")
json.videoDescription t("welcome.video_description")
json.videoUnavailable t("welcome.video_unavailable")
json.videoFailed t("welcome.video_failed")
json.readmeLabel t("welcome.readme_label")
json.readmeDescription t("welcome.readme_description")
json.readmePath "https://github.com/github/replica#readme"
json.setupLabel t("welcome.setup_label")
json.setupDescription t("welcome.setup_description")
json.setupPath "https://github.com/github/replica/blob/main/docs/getting-started.md"
json.createLabel t("welcome.create_label")
json.createDescription t("welcome.create_description")
json.createUnavailable t("welcome.create_unavailable")
json.hideLabel t("welcome.hide_label")
json.hideDescription t("welcome.hide_description")
json.hidePath(Current.user.welcome_hidden? ? nil :
  welcome_path(repository_github_id: hub_repository_workspace.fetch(:repository)&.route_id))
json.notice flash[:notice]
json.workspace do
  json.partial! \
    partial: "shared/hub_workspace",
    locals: { navigation_label: t("repository_workspace.navigation") }
  json.selectedSection "welcome"
end
