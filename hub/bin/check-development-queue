#!/bin/sh
set -eu

pid=""
cleanup() {
  if [ -n "$pid" ]; then
    kill -TERM "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

bin/jobs >tmp/development-queue-check.log 2>&1 &
pid=$!

attempt=0
while [ "$attempt" -lt 30 ]; do
  if ! kill -0 "$pid" 2>/dev/null; then
    wait "$pid" || true
    cat tmp/development-queue-check.log
    exit 1
  fi

  if bin/rails runner 'exit(SolidQueue::Process.where(kind: %w[Dispatcher Worker]).distinct.count(:kind) == 2 ? 0 : 1)' >/dev/null 2>&1; then
    sleep 1
    kill -0 "$pid" 2>/dev/null && exit 0
  fi

  attempt=$((attempt + 1))
  sleep 0.2
done

cat tmp/development-queue-check.log
exit 1
