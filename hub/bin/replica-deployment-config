#!/usr/bin/env ruby

require "optparse"
require_relative "../lib/replica_deployment/configuration"

options = { format: "dotenv" }
parser = OptionParser.new do |option|
  option.banner = "Usage: bin/replica-deployment-config generate --host HOST [--format dotenv|json]"
  option.on("--host HOST", "Public Replica Hub hostname") { options[:host] = _1 }
  option.on("--format FORMAT", "Output format: dotenv or json") { options[:format] = _1 }
end

command = ARGV.shift
if command != "generate"
  warn parser
  exit 2
end

begin
  parser.parse!(ARGV)
  raise OptionParser::MissingArgument, "--host" if options[:host].to_s.empty?
  raise OptionParser::InvalidArgument, ARGV.join(" ") if ARGV.any?

  configuration = ReplicaDeployment::Configuration.generate(options.fetch(:host))
  print ReplicaDeployment::Formatter.format(configuration, options.fetch(:format))
rescue OptionParser::ParseError,
       ReplicaDeployment::Configuration::InvalidHost,
       ReplicaDeployment::Formatter::InvalidFormat => error
  warn "replica-deployment-config: #{error.message}"
  exit 2
end
