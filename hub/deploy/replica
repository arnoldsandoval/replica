#!/bin/sh
set -eu

DEPLOY_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
COMPOSE_FILE="$DEPLOY_ROOT/compose.yml"
ENV_FILE="$DEPLOY_ROOT/.env"
IMAGE=${REPLICA_IMAGE:-ghcr.io/github/replica-hub:1}

usage() {
  printf '%s\n' \
    "Usage: ./replica COMMAND [arguments]" \
    "" \
    "Commands:" \
    "  init [HOST]   Create deployment configuration" \
    "  up            Start Replica Hub" \
    "  down          Stop Replica Hub" \
    "  status        Show Replica Hub status" \
    "  logs          Follow Replica Hub logs" \
    "  update        Install the latest compatible release"
}

require_docker() {
  command -v docker >/dev/null 2>&1 || {
    printf '%s\n' "Replica Hub requires Docker." >&2
    exit 1
  }
  docker compose version >/dev/null 2>&1 || {
    printf '%s\n' "Replica Hub requires the Docker Compose plugin." >&2
    exit 1
  }
}

require_configuration() {
  [ -f "$ENV_FILE" ] || {
    printf '%s\n' "Run ./replica init before starting Replica Hub." >&2
    exit 1
  }
}

compose() {
  docker compose --file "$COMPOSE_FILE" --project-directory "$DEPLOY_ROOT" "$@"
}

configuration_value() {
  key=$1
  sed -n "s/^${key}=//p" "$ENV_FILE" | head -1
}

container_status() {
  container_id=$(compose ps --quiet hub)
  if [ -z "$container_id" ]; then
    printf '%s\n' "stopped"
    return
  fi

  docker inspect \
    --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
    "$container_id"
}

container_version() {
  container_id=$(compose ps --quiet hub)
  [ -n "$container_id" ] || return

  version=$(docker inspect \
    --format '{{index .Config.Labels "org.opencontainers.image.version"}}' \
    "$container_id")
  [ "$version" != "<no value>" ] || return
  printf '%s\n' "$version"
}

print_running() {
  version=$(container_version)
  if [ -n "$version" ]; then
    printf '%s\n' "Replica Hub $version is running."
  else
    printf '%s\n' "Replica Hub is running."
  fi
}

wait_until_healthy() {
  attempts=0
  while [ "$attempts" -lt 60 ]; do
    status=$(container_status)
    case "$status" in
      healthy) return ;;
      exited|dead|unhealthy)
        printf '%s\n' "Replica Hub failed to start." >&2
        compose logs --tail 100 hub >&2
        exit 1
        ;;
    esac
    attempts=$((attempts + 1))
    sleep 2
  done

  printf '%s\n' "Replica Hub did not become healthy within two minutes." >&2
  compose logs --tail 100 hub >&2
  exit 1
}

init() {
  [ ! -e "$ENV_FILE" ] || {
    printf '%s\n' "Configuration already exists at $ENV_FILE." >&2
    exit 1
  }
  require_docker

  host=${1:-}
  if [ -z "$host" ]; then
    printf '%s' "Replica Hub hostname: "
    read -r host
  fi

  temporary_file="$ENV_FILE.tmp"
  trap 'rm -f "$temporary_file"' EXIT HUP INT TERM
  umask 077

  printf '%s\n' "Downloading Replica Hub..."
  docker pull "$IMAGE" >/dev/null
  docker run --rm "$IMAGE" \
    bin/replica-deployment-config generate --host "$host" --format dotenv >"$temporary_file"
  mv "$temporary_file" "$ENV_FILE"
  trap - EXIT HUP INT TERM

  hub_origin=$(configuration_value REPLICA_HUB_ORIGIN)
  configured_host=${hub_origin#https://}
  setup_code=$(configuration_value REPLICA_BOOTSTRAP_SECRET)

  printf '\n%s\n' \
    "Configuration created." \
    "" \
    "Create these DNS records:" \
    "  $configured_host" \
    "  *.preview.$configured_host" \
    "" \
    "Enable HTTPS for both addresses." \
    "" \
    "Setup code:" \
    "  $setup_code" \
    "" \
    "When the addresses are ready, run:" \
    "  ./replica up" \
    "" \
    "Replica Hub setup will be available at:" \
    "  $hub_origin/setup"
}

start() {
  require_docker
  require_configuration

  compose up --detach
  wait_until_healthy

  printf '\n%s\n' \
    "$(print_running)" \
    "" \
    "Open:" \
    "  $(configuration_value REPLICA_HUB_ORIGIN)/setup"
}

update() {
  require_docker
  require_configuration

  compose pull
  compose up --detach
  wait_until_healthy
  version=$(container_version)
  if [ -n "$version" ]; then
    printf '%s\n' "Replica Hub $version is up to date."
  else
    printf '%s\n' "Replica Hub is up to date."
  fi
}

command=${1:-help}
[ "$#" -eq 0 ] || shift

case "$command" in
  init)
    [ "$#" -le 1 ] || { usage >&2; exit 2; }
    init "${1:-}"
    ;;
  up)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    start
    ;;
  down)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    require_docker
    require_configuration
    compose down
    ;;
  status)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    require_docker
    require_configuration
    printf 'Replica Hub is %s.\n' "$(container_status)"
    ;;
  logs)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    require_docker
    require_configuration
    compose logs --follow hub
    ;;
  update)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    update
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
