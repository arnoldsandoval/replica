{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/github/replica/learning/v1/provider-manifest.schema.json",
  "title": "Replica memory provider manifest v1",
  "description": "What a memory provider is, which contract versions it supports, which capabilities it offers, and where its data goes. A host checks this before use and refuses a provider that lacks a required capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "contract",
    "capabilities",
    "storage",
    "externalCalls"
  ],
  "properties": {
    "schemaVersion": { "const": "replica.provider/v1" },
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "versions"],
      "properties": {
        "name": { "const": "replica.memory-provider" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "integer", "minimum": 1, "maximum": 1000 }
        }
      }
    },
    "capabilities": {
      "description": "Required by v1 hosts: observation.append, observation.query, memory.store, memory.query, memory.lifecycle, grant.store, audit.store. Optional examples: memory.semantic_search, memory.graph_query, memory.temporal_query, memory.compaction, memory.consolidate.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 64, "pattern": "^[a-z]+(?:\\.[a-z_]+)+$" }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["local", "memory", "remote"] },
        "location": {
          "description": "A non-secret description such as a directory or service name. Never a credential.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "externalCalls": {
      "description": "Hosts this provider sends data to. Empty for a provider that stays on the machine.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "^[A-Za-z0-9.-]+(?::[0-9]{1,5})?$"
      }
    },
    "dataRetention": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
