{
  "description": "Shared vectors for every implementation of the Replica learning contracts. Every v1 digest is the SHA-256 of a value's RFC 8785 canonical JSON, so an implementation must write each case's value as its canonical text and refuse every value in rejects. Validation must reject every value in validation_rejects and accept every value in validation_accepts. A reader that parses, validates, and canonicalizes must give each text in raw_cases and jsonl_cases its canonical form, or refuse it when no form is given, and must refuse nesting deeper than max_depth. An object must not repeat a member name, even when an escape spells it differently.",
  "rejects": [
    { "name": "a number too large for a double", "value": 1e309 },
    { "name": "a negative number too large for a double", "value": -1e309 },
    {
      "name": "a whole number too large for a double",
      "value": 
    },
    { "name": "a lone surrogate", "value": "\ud800" },
    { "name": "a lone surrogate in a name", "value": { "\udc00": 1 } }
  ],
  "validation_rejects": [
    { "name": "a number too large for a double", "value": { "reward": 1e309 } },
    { "name": "a whole number beyond 2^53 - 1", "value": { "counter": 9007199254740992 } },
    { "name": "a negative whole number beyond 2^53 - 1", "value": [-1000000000000000128] },
    { "name": "a large number written with an exponent", "value": [1.5e300] },
    { "name": "a lone surrogate", "value": { "note": "\ud83d" } },
    { "name": "a lone surrogate in a name", "value": { "\ud83d": true } },
    { "name": "a name ending in a backslash", "value": { "x\\": 1 } },
    { "name": "a backslash inside a name", "value": { "a\\b": 1 } }
  ],
  "validation_accepts": [
    { "name": "the largest safe whole number", "value": 9007199254740991 },
    { "name": "the smallest safe whole number", "value": -9007199254740991 },
    { "name": "a fraction", "value": 0.82 },
    { "name": "a surrogate pair", "value": { "\ud83d\ude00": "\ud83d\ude00" } },
    { "name": "a backslash in a value", "value": { "path": "C:\\temp" } }
  ],
  "max_depth": 64,
  "raw_cases": [
    {
      "name": "a repeated name is refused",
      "text": "{\"a\":1,\"a\":2}"
    },
    { "name": "a repeated name written with an escape", "text": "{\"\\u0061\":1,\"a\":2}" },
    { "name": "NaN behind a repeated name", "text": "{\"x\":NaN,\"x\":0}" },
    { "name": "an Infinity literal", "text": "{\"x\":Infinity}" },
    { "name": "a negative Infinity literal", "text": "[-Infinity]" },
    { "name": "a byte order mark", "text": "\ufeff{}" },
    { "name": "a number too large for a double", "text": "{\"x\":1e400}" },
    { "name": "negative zero", "text": "-0", "canonical": "0" },
    { "name": "1.0 and an exponent", "text": "[1.0,1E+2]", "canonical": "[1,100]" },
    { "name": "a subnormal number", "text": "[5e-324]", "canonical": "[5e-324]" },
    { "name": "an escaped name", "text": "{\"\\u00e9\":1}", "canonical": "{\"\u00e9\":1}" },
    {
      "name": "a lone surrogate behind a repeated name",
      "text": "{\"s\":\"\\ud800\",\"s\":\"ok\"}"
    },
    { "name": "a raw control character in a string", "text": "[\"\u0001\"]" },
    { "name": "a no-break space outside a string", "text": "\u00a0[]" },
    { "name": "a leading zero", "text": "[01]" },
    { "name": "a trailing comma", "text": "[1,]" },
    {
      "name": "a line separator inside a string",
      "text": "[\"a\u2028b\"]",
      "canonical": "[\"a\u2028b\"]"
    },
    { "name": "a whole number beyond 2^53 - 1", "text": "{\"n\":9007199254740993}" },
    { "name": "an escaped backslash in a name", "text": "{\"a\\\\b\":1}" },
    {
      "name": "a whole number too long for Python's int, behind a repeated name",
      "text": "{\"x\":,\"x\":0}"
    },
    {
      "name": "a whole number too long for Python's int",
      "text": "{\"x\":}"
    }
  ],
  "jsonl_cases": [
    {
      "name": "lines end at \\n only",
      "text": "{\"a\":\"x\u2028y\"}\n\n \t\r\n{\"b\":1}\r\n",
      "canonical": ["{\"a\":\"x\u2028y\"}", "{\"b\":1}"]
    },
    { "name": "a byte order mark at the start", "text": "\ufeff{\"a\":1}\n" },
    { "name": "a control character is not whitespace", "text": "\u001c{\"a\":1}\n" },
    { "name": "a no-break space is not whitespace", "text": "{\"a\":1}\u00a0\n" }
  ],
  "cases": [
    {
      "name": "sorts object keys",
      "value": {
        "b": 1,
        "a": 2
      },
      "canonical": "{\"a\":2,\"b\":1}"
    },
    {
      "name": "keeps nesting and literals",
      "value": {
        "z": [
          3,
          {
            "y": null,
            "x": true
          }
        ],
        "a": "é"
      },
      "canonical": "{\"a\":\"é\",\"z\":[3,{\"x\":true,\"y\":null}]}"
    },
    {
      "name": "writes a small number in exponent form",
      "value": 1e-7,
      "canonical": "1e-7"
    },
    {
      "name": "writes 0.00001 in fixed form",
      "value": 0.00001,
      "canonical": "0.00001"
    },
    {
      "name": "writes 1e21 in exponent form",
      "value": 1e21,
      "canonical": "1e+21"
    },
    {
      "name": "writes 1e20 as an integer",
      "value": 100000000000000000000,
      "canonical": "100000000000000000000"
    },
    {
      "name": "writes a decimal",
      "value": 0.82,
      "canonical": "0.82"
    },
    {
      "name": "writes a negative number",
      "value": -1.5,
      "canonical": "-1.5"
    },
    {
      "name": "writes the shortest round-trip digits",
      "value": 0.30000000000000004,
      "canonical": "0.30000000000000004"
    },
    {
      "name": "writes a large exponent with a fraction",
      "value": 1.5e300,
      "canonical": "1.5e+300"
    },
    {
      "name": "writes a whole number beyond 2^53 with the shortest digits of its double",
      "value": 1000000000000000128,
      "canonical": "1000000000000000100"
    },
    {
      "name": "rounds a whole number to the nearest double first",
      "value": 9007199254740993,
      "canonical": "9007199254740992"
    },
    {
      "name": "writes zero",
      "value": 0,
      "canonical": "0"
    },
    {
      "name": "escapes quotes, backslashes, and whitespace",
      "value": "line\nbreak \"quoted\" \\ tab\t",
      "canonical": "\"line\\nbreak \\\"quoted\\\" \\\\ tab\\t\""
    },
    {
      "name": "escapes control characters in lowercase hex",
      "value": "\u0001",
      "canonical": "\"\\u0001\""
    },
    {
      "name": "sorts keys by UTF-16 code units",
      "value": {
        "": 1,
        "😀": 2
      },
      "canonical": "{\"😀\":2,\"\":1}"
    }
  ]
}
